---
const navItems = [
  { href: '/', label: '索引' },
  { href: '/themes', label: '主题' },
  { href: '/works', label: '项目' },
  { href: '/about', label: '关于' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="shell nav-inner">
    <a href="/" class="nav-brand">
      pemiamos
      <span class="nav-brand-sub">设计研究 · 自 2008 年</span>
    </a>
    <div class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': currentPath === item.href || currentPath.startsWith(item.href + '/') && item.href !== '/' }]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
